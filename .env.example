# Proveedor del modelo. Si no hay clave, el servidor arranca con un guion determinista "sin-modelo".
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=45000

# Control de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000

# Opcional: si se define, el front pide esta clave antes de usar la API (header x-access-key).
ACCESS_KEY=

# Opcional: carpeta de salida (en hosting con disco efímero, por ejemplo /tmp/out)
OUT_DIR=
# Zona horaria para la fecha de las OC (por defecto America/Bogota)
ZONA_HORARIA=
PORT=3000
